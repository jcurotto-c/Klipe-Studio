# Supply-chain hardening — see https://tanstack.com/blog/npm-supply-chain-compromise-postmortem
#
# Always write exact version numbers (no ^ or ~) when `npm install --save` is run.
# The lockfile already pins transitive deps; this pins direct deps going forward.
save-exact=true

# Suppress funding prompts.
fund=false

# Run an audit automatically after every install.
# NOTE: this reports issues but does NOT block the install.
# To enforce blocking on CI, run `pnpm audit --audit-level=high` as a separate step.
audit=true

# NOTE: pnpm-specific settings (node-linker, only-built-dependencies, etc.) do
# NOT belong here — pnpm 11 ignores them in .npmrc. They live in
# pnpm-workspace.yaml as camelCase keys (nodeLinker, onlyBuiltDependencies).
# In particular nodeLinker: hoisted is required so electron-builder can bundle
# transitive deps (e.g. electron-updater -> fs-extra). See pnpm-workspace.yaml.
