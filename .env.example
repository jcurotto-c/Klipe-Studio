# Copy this file to `.env` and fill in the value. `.env` is gitignored.
#
# GH_TOKEN: a GitHub Personal Access Token used by `pnpm release` to publish a
# GitHub Release and upload the Windows installer. Recommended: fine-grained,
# scoped to ONLY this repo, with "Contents: Read and write" permission.
# Generate at https://github.com/settings/tokens?type=beta
GH_TOKEN=
